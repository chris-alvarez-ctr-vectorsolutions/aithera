{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vectorsolutions.com/schemas/lo-cml/4.0/lo_cml_v4.schema.json",
  "title": "Scenario CML v4 — AI Scenario Simulator (implementation-root, content-only)",
  "type": "object",
  "required": ["implementation_id", "modality", "schema_version", "content"],
  "properties": {
    "implementation_id": { "type": "string", "minLength": 1 },
    "modality": { "const": "ai-conversational" },
    "schema_version": { "type": "string", "pattern": "^4\\." },
    "content": { "$ref": "#/$defs/content" }
  },
  "additionalProperties": false,
  "$defs": {
    "content": {
      "type": "object",
      "required": ["title", "coach_persona", "teaching_points", "phases", "closing"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "narrative": { "type": "string", "minLength": 1 },
        "scene_world": { "$ref": "#/$defs/sceneWorld" },
        "coach_persona": { "type": "string", "minLength": 1 },
        "tone_guidelines": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "teaching_points": {
          "type": "array",
          "items": { "$ref": "#/$defs/teachingTopic" },
          "minItems": 1
        },
        "misconceptions": {
          "type": "array",
          "items": { "$ref": "#/$defs/misconception" }
        },
        "opening": { "$ref": "#/$defs/opening" },
        "phases": {
          "type": "array",
          "items": { "$ref": "#/$defs/phase" },
          "minItems": 1
        },
        "closing": { "$ref": "#/$defs/closing" },
        "landing_cta_label": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "sceneWorld": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "setting": { "type": "string", "minLength": 1 },
        "canon": { "$ref": "#/$defs/canon" },
        "characters": {
          "type": "array",
          "items": { "$ref": "#/$defs/character" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "required": ["type", "src"],
      "properties": {
        "type": { "enum": ["image", "video"] },
        "src": { "type": "string", "minLength": 1 },
        "alt": { "type": "string" }
      },
      "additionalProperties": false
    },
    "exhibit": {
      "type": "object",
      "required": ["type", "src"],
      "properties": {
        "type": { "enum": ["image", "video"] },
        "src": { "type": "string", "minLength": 1 },
        "alt": { "type": "string" },
        "facts": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "teachingTopic": {
      "type": "object",
      "required": ["topic", "points"],
      "properties": {
        "topic": { "type": "string" },
        "points": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "misconception": {
      "type": "object",
      "required": ["misconception", "redirect"],
      "properties": {
        "misconception": { "type": "string" },
        "redirect": { "type": "string" }
      },
      "additionalProperties": false
    },
    "canon": {
      "type": "object",
      "required": ["facts"],
      "properties": {
        "facts": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "character": {
      "type": "object",
      "required": ["id", "name", "role"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "behavior": { "$ref": "#/$defs/behavior" },
        "canon_facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/canonFact" }
        }
      },
      "additionalProperties": false
    },
    "behavior": {
      "type": "object",
      "properties": {
        "driver": { "type": "string" },
        "baseline": { "type": "string" },
        "guardrails": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "canonFact": {
      "type": "object",
      "required": ["fact"],
      "properties": {
        "fact": { "type": "string" },
        "reveal_when": { "type": "string" }
      },
      "additionalProperties": false
    },
    "openingMessage": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "character_id": { "type": "string" },
        "emotion": { "type": "string" }
      },
      "additionalProperties": false
    },
    "briefMessage": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "example": {
      "type": "object",
      "required": ["learner", "reply"],
      "properties": {
        "learner": { "type": "string", "minLength": 1 },
        "reply": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "level": {
      "type": "object",
      "required": ["look_for", "response"],
      "properties": {
        "look_for": { "type": "string", "minLength": 1 },
        "response": { "type": "string", "minLength": 1 },
        "progression": { "type": "string", "minLength": 1 },
        "example": { "$ref": "#/$defs/example" }
      },
      "additionalProperties": false
    },
    "levels": {
      "type": "object",
      "required": ["unthoughtful", "neutral", "strong"],
      "properties": {
        "unthoughtful": { "$ref": "#/$defs/level" },
        "neutral": { "$ref": "#/$defs/level" },
        "strong": { "$ref": "#/$defs/level" }
      },
      "additionalProperties": false
    },
    "openingLevel": {
      "type": "object",
      "required": ["look_for", "response"],
      "properties": {
        "look_for": { "type": "string", "minLength": 1 },
        "response": { "type": "string", "minLength": 1 },
        "example": { "$ref": "#/$defs/example" }
      },
      "additionalProperties": false
    },
    "openingLevels": {
      "type": "object",
      "anyOf": [
        { "required": ["unthoughtful"] },
        { "required": ["neutral"] },
        { "required": ["strong"] }
      ],
      "properties": {
        "unthoughtful": { "$ref": "#/$defs/openingLevel" },
        "neutral": { "$ref": "#/$defs/openingLevel" },
        "strong": { "$ref": "#/$defs/openingLevel" }
      },
      "additionalProperties": false
    },
    "openingExit": {
      "type": "object",
      "required": ["when"],
      "properties": {
        "when": {
          "type": "object",
          "required": ["turns"],
          "properties": {
            "turns": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "final_word": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "practiceExit": {
      "type": "object",
      "required": ["when"],
      "properties": {
        "when": {
          "type": "object",
          "required": ["turns"],
          "properties": {
            "requirement": { "type": "string", "minLength": 1 },
            "turns": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "final_word": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "rubricItem": {
      "type": "object",
      "required": ["id", "name", "standard_term", "nudge"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "standard_term": { "type": "string" },
        "nudge": { "type": "string" }
      },
      "additionalProperties": false
    },
    "conditionalProbe": {
      "type": "object",
      "required": ["required_concepts", "probe"],
      "properties": {
        "required_concepts": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "probe": { "type": "string" }
      },
      "additionalProperties": false
    },
    "carryoverItem": {
      "type": "object",
      "required": ["from"],
      "properties": {
        "from": { "type": "string" }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": ["button_label"],
      "properties": {
        "button_label": { "type": "string", "minLength": 1 },
        "text": { "type": "string" }
      },
      "additionalProperties": false
    },
    "idealResponse": {
      "type": "object",
      "required": ["component_groups", "summary"],
      "properties": {
        "component_groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["components"],
            "properties": {
              "title": { "type": "string" },
              "components": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              }
            },
            "additionalProperties": false
          }
        },
        "summary": { "type": "string", "minLength": 1 },
        "source_references": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "opening": {
      "type": "object",
      "required": ["id", "label", "purpose", "opening_messages", "exit", "transition"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "input_placeholder": { "type": "string" },
        "purpose": { "type": "string", "minLength": 1 },
        "opening_messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/openingMessage" },
          "minItems": 1
        },
        "levels": { "$ref": "#/$defs/openingLevels" },
        "exit": { "$ref": "#/$defs/openingExit" },
        "conditional_probes": {
          "type": "array",
          "items": { "$ref": "#/$defs/conditionalProbe" }
        },
        "transition": { "$ref": "#/$defs/transition" }
      },
      "additionalProperties": false
    },
    "closing": {
      "type": "object",
      "required": ["ideal_response"],
      "properties": {
        "partner_label": { "type": "string" },
        "ideal_response": { "$ref": "#/$defs/idealResponse" }
      },
      "additionalProperties": false
    },
    "coachInteraction": {
      "type": "object",
      "required": ["opening_messages"],
      "properties": {
        "opening_messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/openingMessage" },
          "minItems": 1
        },
        "levels": { "$ref": "#/$defs/levels" },
        "input_placeholder": { "type": "string" },
        "partner_label": { "type": "string" },
        "media": { "$ref": "#/$defs/media" }
      },
      "additionalProperties": false
    },
    "roleplayInteraction": {
      "type": "object",
      "required": ["setting", "partner_label", "opening_messages"],
      "properties": {
        "setting": { "type": "string", "minLength": 1 },
        "character_id": { "type": ["string", "null"] },
        "emotion_hint": { "type": "string" },
        "partner_label": { "type": "string", "minLength": 1 },
        "opening_messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/openingMessage" },
          "minItems": 1
        },
        "levels": { "$ref": "#/$defs/levels" },
        "input_placeholder": { "type": "string" },
        "help_turns": { "type": "integer", "minimum": 0 },
        "carryover": {
          "type": "array",
          "items": { "$ref": "#/$defs/carryoverItem" }
        }
      },
      "additionalProperties": false
    },
    "observeInteraction": {
      "type": "object",
      "required": ["exhibit", "rubric", "spot_target", "brief"],
      "properties": {
        "exhibit": { "$ref": "#/$defs/exhibit" },
        "rubric": {
          "type": "array",
          "items": { "$ref": "#/$defs/rubricItem" },
          "minItems": 1
        },
        "spot_target": { "type": "integer", "minimum": 1 },
        "brief": {
          "type": "array",
          "items": { "$ref": "#/$defs/briefMessage" },
          "minItems": 1
        },
        "levels": { "$ref": "#/$defs/levels" },
        "jot_placeholder": { "type": "string" },
        "partner_label": { "type": "string" },
        "help_turns": { "type": "integer", "minimum": 0 },
        "carryover": {
          "type": "array",
          "items": { "$ref": "#/$defs/carryoverItem" }
        }
      },
      "additionalProperties": false
    },
    "practice": {
      "type": "object",
      "required": ["mode", "purpose", "exit", "transition", "interaction"],
      "properties": {
        "mode": { "enum": ["coach_inquiry", "roleplay", "observe_react"] },
        "label": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "exit": { "$ref": "#/$defs/practiceExit" },
        "transition": { "$ref": "#/$defs/transition" },
        "interaction": { "type": "object" }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "mode": { "const": "coach_inquiry" },
            "interaction": { "$ref": "#/$defs/coachInteraction" }
          },
          "required": ["mode"]
        },
        {
          "properties": {
            "mode": { "const": "roleplay" },
            "interaction": { "$ref": "#/$defs/roleplayInteraction" }
          },
          "required": ["mode"]
        },
        {
          "properties": {
            "mode": { "const": "observe_react" },
            "interaction": { "$ref": "#/$defs/observeInteraction" }
          },
          "required": ["mode"]
        }
      ]
    },
    "probe": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "levels": { "$ref": "#/$defs/levels" }
      },
      "additionalProperties": false
    },
    "debrief": {
      "type": "object",
      "required": ["label", "key_points", "follow_up_turns", "transition"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "partner_label": { "type": "string" },
        "key_points": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "levels": { "$ref": "#/$defs/levels" },
        "probe": { "$ref": "#/$defs/probe" },
        "follow_up_turns": { "type": "integer", "minimum": 0 },
        "requirement": { "type": "string", "minLength": 1 },
        "input_placeholder": { "type": "string" },
        "final_word": { "type": "string", "minLength": 1 },
        "transition": { "$ref": "#/$defs/transition" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "follow_up_turns": { "const": 0 } },
            "required": ["follow_up_turns"]
          },
          "then": {
            "required": ["final_word"],
            "not": {
              "anyOf": [
                { "required": ["probe"] },
                { "required": ["requirement"] },
                { "required": ["input_placeholder"] }
              ]
            }
          }
        }
      ]
    },
    "phase": {
      "type": "object",
      "required": ["id", "label", "purpose", "practice", "debrief"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "practice": { "$ref": "#/$defs/practice" },
        "debrief": { "$ref": "#/$defs/debrief" }
      },
      "additionalProperties": false
    }
  }
}
