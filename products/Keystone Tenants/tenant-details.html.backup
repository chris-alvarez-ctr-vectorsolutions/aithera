<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tenant Details - Keystone Tenants</title>

  <!-- Vector Web Components CSS -->
  <script
    type="module"
    src="https://cdn.vsp-prod.com/web-components/@vector-web-components/core/v1.5.1/core.iife.js">
  </script>

  <!-- Vector Web Components JavaScript -->
  <script
    src="https://cdn.vsp-prod.com/web-components/@vector-web-components/themes/v1.1.1/styles.js">
  </script>

  <!-- Open Sans Font -->
  <link
    rel="stylesheet"
    href="https://cdn.vsp-prod.com/web-components/@vector-web-components/assets/v1.0.0/fonts/open-sans/v43/open-sans.css"
  />

  <!-- Font Awesome 6 Icons -->
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
  />

  <!-- Custom Styles -->
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <div class="app-container">
    <!-- Back Button -->
    <div class="back-button-container">
      <vaadin-button id="backButton" theme="tertiary">
        <i class="fa-solid fa-arrow-left" style="margin-right: 8px;"></i>
        Back to Tenant Grid
      </vaadin-button>
    </div>

    <!-- Page Header -->
    <header class="page-header">
      <h1 class="page-title" id="pageTitle">Tenant Details</h1>
    </header>

    <!-- Details Layout -->
    <div class="details-layout">
      <!-- Left Pane: Tenant Details -->
      <div class="details-pane">
        <div class="details-pane-header">
          <h2 class="details-pane-title">Tenant Information</h2>
        </div>

        <!-- Custom Accordion for Tenant Details -->
        <div id="tenantDetailsAccordion" style="border: 1px solid #d1d5db; border-radius: 4px; overflow: hidden; background: white; margin-bottom: 24px;">
          <!-- Accordion Header -->
          <div id="accordionHeader" style="display: flex; align-items: center; justify-content: space-between; height: 56px; padding: 0 16px; cursor: pointer; user-select: none;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <i id="accordionChevron" class="fa-solid fa-chevron-right" style="color: #6b7280; font-size: 12px; transition: transform 0.2s;"></i>
              <span style="font-weight: 600; font-size: 14px;">Details</span>
            </div>
            <div id="accordionHeaderActions" style="display: none; gap: 8px; align-items: center;">
              <vaadin-button id="editButton" theme="tertiary small" style="height: 32px; min-height: 32px; padding: 0 8px;">
                <i class="fa-solid fa-pen" style="margin-right: 4px;"></i>
                Edit
              </vaadin-button>
              <div id="editModeActions" class="hidden" style="display: flex; gap: 8px;">
                <vaadin-button id="cancelEditButtonHeader" theme="small" style="height: 32px; min-height: 32px;">
                  Cancel
                </vaadin-button>
                <vaadin-button id="saveButtonHeader" theme="primary small" style="height: 32px; min-height: 32px;">
                  Save
                </vaadin-button>
              </div>
            </div>
          </div>

          <!-- Accordion Content -->
          <div id="accordionContent" style="display: none; padding: 16px; border-top: 1px solid #d1d5db;">
              <div>
              <!-- Readonly View -->
              <div id="readonlyView">
                <div class="form-section">
                  <div class="readonly-field">
                    <div class="readonly-label">Keystone Tenant Name</div>
                    <div class="readonly-value" id="displayName">—</div>
                  </div>

                  <div class="readonly-field">
                    <div class="readonly-label">UUID</div>
                    <div class="readonly-value uuid">
                      <span id="displayUuid">—</span>
                      <i class="fa-solid fa-copy copy-uuid-btn" id="copyUuidBtn" title="Copy UUID to clipboard"></i>
                    </div>
                  </div>

                  <div class="readonly-field">
                    <div class="readonly-label">Address Line 1</div>
                    <div class="readonly-value" id="displayAddress1">—</div>
                  </div>

                  <div class="readonly-field">
                    <div class="readonly-label">Address Line 2</div>
                    <div class="readonly-value" id="displayAddress2">—</div>
                  </div>

                  <div class="readonly-row">
                    <div class="readonly-field city">
                      <div class="readonly-label">City</div>
                      <div class="readonly-value" id="displayCity">—</div>
                    </div>

                    <div class="readonly-field state">
                      <div class="readonly-label">State/Province</div>
                      <div class="readonly-value" id="displayState">—</div>
                    </div>

                    <div class="readonly-field postal-code">
                      <div class="readonly-label">Postal Code</div>
                      <div class="readonly-value" id="displayPostalCode">—</div>
                    </div>
                  </div>

                  <div class="readonly-field">
                    <div class="readonly-label">Country</div>
                    <div class="readonly-value" id="displayCountry">—</div>
                  </div>
                </div>
              </div>

              <!-- Edit View -->
              <div id="editView" class="hidden">
                <form id="editForm">
                  <div class="form-section">
                    <div class="form-field">
                      <vaadin-text-field
                        id="editName"
                        label="Keystone Tenant Name"
                        required
                        theme="outlined">
                      </vaadin-text-field>
                    </div>

                    <div class="form-field">
                      <div class="readonly-field">
                        <div class="readonly-label">UUID (Not Editable)</div>
                        <div class="readonly-value uuid" id="editUuid">—</div>
                      </div>
                    </div>

                    <div class="form-field">
                      <vaadin-text-field
                        id="editAddress1"
                        label="Address Line 1"
                        required
                        theme="outlined">
                      </vaadin-text-field>
                    </div>

                    <div class="form-field">
                      <vaadin-text-field
                        id="editAddress2"
                        label="Address Line 2"
                        theme="outlined">
                      </vaadin-text-field>
                    </div>

                    <div class="form-row">
                      <div class="form-field city">
                        <vaadin-text-field
                          id="editCity"
                          label="City"
                          required
                          theme="outlined">
                        </vaadin-text-field>
                      </div>

                      <div class="form-field state">
                        <vaadin-select
                          id="editState"
                          label="State/Province"
                          theme="outlined">
                        </vaadin-select>
                      </div>

                      <div class="form-field postal-code">
                        <vaadin-text-field
                          id="editPostalCode"
                          label="Postal Code"
                          theme="outlined">
                        </vaadin-text-field>
                      </div>
                    </div>

                    <div class="form-field">
                      <vaadin-select
                        id="editCountry"
                        label="Country"
                        theme="outlined">
                      </vaadin-select>
                    </div>
                  </div>
                </form>
              </div>
              </div>
          </div>
        </div>

        <!-- Product Mappings Section -->
        <div class="product-mappings">
          <h3 class="product-mappings-title">Product Mappings</h3>
          <div class="product-list" id="productList">
            <!-- Product items will be populated by JavaScript -->
          </div>
        </div>
      </div>

      <!-- Right Pane: Product Mapping (initially hidden) -->
      <div class="mapping-pane hidden" id="mappingPane">
        <div class="mapping-pane-header">
          <h2 class="mapping-pane-title" id="mappingPaneTitle">Select Product Tenant</h2>
        </div>

        <div class="drawer-search">
          <vaadin-text-field
            id="productTenantSearch"
            placeholder="Search product tenants..."
            theme="outlined"
            clear-button-visible
            style="width: 100%;">
            <i slot="prefix" class="fa-solid fa-magnifying-glass"></i>
          </vaadin-text-field>
        </div>

        <div class="mapping-grid-container">
          <table class="product-tenant-grid">
            <thead>
              <tr>
                <th>Product Tenant Name</th>
                <th>City</th>
                <th>State</th>
                <th>ID</th>
              </tr>
            </thead>
            <tbody id="productTenantGridBody">
              <!-- Product tenant rows will be populated by JavaScript -->
            </tbody>
          </table>
        </div>

        <div id="productTenantsEmpty" class="empty-state hidden">
          <div class="empty-state-icon">
            <i class="fa-solid fa-inbox"></i>
          </div>
          <div class="empty-state-title">No product tenants found</div>
          <div class="empty-state-description">
            Try adjusting your search
          </div>
        </div>
      </div>
    </div>

    <!-- Loading State -->
    <div id="loadingState" class="loading-container hidden">
      <vwc-spinner></vwc-spinner>
    </div>
  </div>

  <!-- Notification -->
  <vaadin-notification
    id="notification"
    duration="3000"
    position="bottom-start">
  </vaadin-notification>

  <!-- JavaScript Modules -->
  <script type="module">
    import {
      getKeystoneTenant,
      updateKeystoneTenant,
      getProductTenants,
      mapProductTenant,
      unmapProductTenant,
      getStates,
      getCountries,
      VECTOR_PRODUCTS
    } from './api.js';

    import {
      getSelectedTenantUuid,
      navigateToTenantGrid,
      markFormDirty,
      markFormClean,
      checkUnsavedChanges,
      setupNavigationGuard,
      confirmNavigationWithUnsavedChanges
    } from './state.js';

    // State
    let currentTenant = null;
    let currentProduct = null;
    let allProductTenants = [];
    let filteredProductTenants = [];
    let isEditMode = false;

    // Elements
    const backButton = document.getElementById('backButton');
    const pageTitle = document.getElementById('pageTitle');
    const editButton = document.getElementById('editButton');
    const editModeActions = document.getElementById('editModeActions');
    const readonlyView = document.getElementById('readonlyView');
    const editView = document.getElementById('editView');
    const editForm = document.getElementById('editForm');
    const cancelEditButtonHeader = document.getElementById('cancelEditButtonHeader');
    const saveButtonHeader = document.getElementById('saveButtonHeader');
    const productList = document.getElementById('productList');
    const mappingPane = document.getElementById('mappingPane');
    const mappingPaneTitle = document.getElementById('mappingPaneTitle');
    const productTenantSearch = document.getElementById('productTenantSearch');
    const productTenantGridBody = document.getElementById('productTenantGridBody');
    const productTenantsEmpty = document.getElementById('productTenantsEmpty');
    const loadingState = document.getElementById('loadingState');
    const notification = document.getElementById('notification');
    const copyUuidBtn = document.getElementById('copyUuidBtn');

    // Setup navigation guard
    setupNavigationGuard();

    // Copy UUID to clipboard
    copyUuidBtn.addEventListener('click', async () => {
      if (!currentTenant) return;

      try {
        await navigator.clipboard.writeText(currentTenant.uuid);
        showNotification('UUID copied to clipboard', 'success');

        // Visual feedback - change icon temporarily
        copyUuidBtn.classList.remove('fa-copy');
        copyUuidBtn.classList.add('fa-check');
        setTimeout(() => {
          copyUuidBtn.classList.remove('fa-check');
          copyUuidBtn.classList.add('fa-copy');
        }, 1500);
      } catch (err) {
        console.error('Failed to copy UUID:', err);
        showNotification('Failed to copy UUID', 'error');
      }
    });

    // Load tenant details
    async function loadTenantDetails() {
      const uuid = getSelectedTenantUuid();

      console.log('Loading tenant with UUID:', uuid);

      if (!uuid) {
        console.error('No UUID found in session storage');
        showNotification('No tenant selected', 'error');
        setTimeout(() => navigateToTenantGrid(), 2000);
        return;
      }

      showLoading();

      try {
        currentTenant = await getKeystoneTenant(uuid);
        console.log('Loaded tenant:', currentTenant);
        renderTenantDetails();
        renderProductMappings();
        hideLoading();
      } catch (error) {
        console.error('Failed to load tenant:', error);
        showNotification('Failed to load tenant details', 'error');
        hideLoading();
        setTimeout(() => navigateToTenantGrid(), 2000);
      }
    }

    // Render tenant details
    function renderTenantDetails() {
      // Update page title
      pageTitle.textContent = currentTenant.name;

      // Readonly view
      document.getElementById('displayName').textContent = currentTenant.name;
      document.getElementById('displayUuid').textContent = currentTenant.uuid;
      document.getElementById('displayAddress1').textContent = currentTenant.address1 || '—';
      document.getElementById('displayAddress2').textContent = currentTenant.address2 || '—';
      document.getElementById('displayCity').textContent = currentTenant.city;
      document.getElementById('displayState').textContent = currentTenant.state;
      document.getElementById('displayPostalCode').textContent = currentTenant.postalCode || '—';
      document.getElementById('displayCountry').textContent = currentTenant.country;

      // Edit view
      document.getElementById('editName').value = currentTenant.name;
      document.getElementById('editUuid').textContent = currentTenant.uuid;
      document.getElementById('editAddress1').value = currentTenant.address1;
      document.getElementById('editAddress2').value = currentTenant.address2;
      document.getElementById('editCity').value = currentTenant.city;
      document.getElementById('editPostalCode').value = currentTenant.postalCode;

      // Populate dropdowns
      const editState = document.getElementById('editState');
      const states = getStates();
      editState.items = states.map(s => ({ label: s.name, value: s.code }));
      editState.value = currentTenant.state;

      const editCountry = document.getElementById('editCountry');
      const countries = getCountries();
      editCountry.items = countries.map(c => ({ label: c.name, value: c.name }));
      editCountry.value = currentTenant.country;
    }

    // Render product mappings
    function renderProductMappings() {
      productList.innerHTML = '';

      VECTOR_PRODUCTS.forEach(product => {
        const mapping = currentTenant.mappedProducts[product];
        const productItem = document.createElement('div');
        productItem.className = 'product-item' + (mapping ? ' mapped' : '');
        productItem.setAttribute('tabindex', '0');
        productItem.setAttribute('role', 'button');

        const contentDiv = document.createElement('div');
        contentDiv.className = 'product-item-content';

        const nameDiv = document.createElement('div');
        nameDiv.className = 'product-name';
        nameDiv.textContent = product;

        const statusDiv = document.createElement('div');
        statusDiv.className = 'product-mapping-status' + (mapping ? ' mapped' : '');
        statusDiv.textContent = mapping ? mapping.productTenantName : 'Not mapped';

        contentDiv.appendChild(nameDiv);
        contentDiv.appendChild(statusDiv);

        const actionsDiv = document.createElement('div');
        actionsDiv.className = 'product-item-actions';

        if (mapping) {
          const unmapButton = document.createElement('vaadin-button');
          unmapButton.textContent = 'Unmap';
          unmapButton.className = 'unmap-button';
          unmapButton.setAttribute('theme', 'tertiary error small');
          unmapButton.addEventListener('click', (e) => {
            e.stopPropagation();
            handleUnmapProduct(product);
          });
          actionsDiv.appendChild(unmapButton);
        } else {
          const mapIcon = document.createElement('i');
          mapIcon.className = 'fa-solid fa-chevron-right';
          mapIcon.style.color = 'var(--lumo-secondary-text-color)';
          actionsDiv.appendChild(mapIcon);
        }

        productItem.appendChild(contentDiv);
        productItem.appendChild(actionsDiv);

        // Click handler to open mapping pane
        if (!mapping) {
          productItem.addEventListener('click', () => {
            openProductMapping(product);
          });

          productItem.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              openProductMapping(product);
            }
          });
        }

        productList.appendChild(productItem);
      });
    }

    // Open product mapping pane
    async function openProductMapping(product) {
      if (isEditMode) {
        showNotification('Please save or cancel your changes first', 'warning');
        return;
      }

      currentProduct = product;
      mappingPaneTitle.textContent = `Map ${product} Tenant`;
      mappingPane.classList.remove('hidden');

      try {
        allProductTenants = await getProductTenants(product, true); // Only unmapped tenants
        filteredProductTenants = [...allProductTenants];
        renderProductTenantGrid();
      } catch (error) {
        console.error('Failed to load product tenants:', error);
        showNotification('Failed to load product tenants', 'error');
      }
    }

    // Render product tenant grid
    function renderProductTenantGrid() {
      const searchQuery = productTenantSearch.value.toLowerCase().trim();

      // Filter
      if (searchQuery) {
        filteredProductTenants = allProductTenants.filter(tenant =>
          tenant.name.toLowerCase().includes(searchQuery) ||
          tenant.city.toLowerCase().includes(searchQuery) ||
          tenant.state.toLowerCase().includes(searchQuery)
        );
      } else {
        filteredProductTenants = [...allProductTenants];
      }

      productTenantGridBody.innerHTML = '';

      if (filteredProductTenants.length === 0) {
        productTenantsEmpty.classList.remove('hidden');
        return;
      }

      productTenantsEmpty.classList.add('hidden');

      filteredProductTenants.forEach((tenant, index) => {
        const row = document.createElement('tr');
        row.setAttribute('tabindex', '0');
        row.dataset.productTenantId = tenant.id;

        row.innerHTML = `
          <td>${escapeHtml(tenant.name)}</td>
          <td>${escapeHtml(tenant.city)}</td>
          <td>${escapeHtml(tenant.state)}</td>
          <td style="font-family: 'Courier New', monospace; font-size: 12px; color: var(--lumo-secondary-text-color);">${escapeHtml(tenant.id)}</td>
        `;

        // Click handler
        row.addEventListener('click', () => {
          handleMapProductTenant(tenant.id);
        });

        // Keyboard handler
        row.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            handleMapProductTenant(tenant.id);
          } else if (e.key === 'ArrowDown') {
            e.preventDefault();
            const nextRow = e.target.nextElementSibling;
            if (nextRow) nextRow.focus();
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            const prevRow = e.target.previousElementSibling;
            if (prevRow) prevRow.focus();
          } else if (e.key === 'Escape') {
            e.preventDefault();
            closeProductMapping();
          }
        });

        productTenantGridBody.appendChild(row);
      });
    }

    // Handle map product tenant
    async function handleMapProductTenant(productTenantId) {
      try {
        currentTenant = await mapProductTenant(currentTenant.uuid, currentProduct, productTenantId);
        showNotification(`Mapped ${currentProduct} tenant successfully`, 'success');
        renderProductMappings();
        closeProductMapping();
      } catch (error) {
        console.error('Failed to map product tenant:', error);
        showNotification('Failed to map product tenant', 'error');
      }
    }

    // Handle unmap product
    async function handleUnmapProduct(product) {
      try {
        currentTenant = await unmapProductTenant(currentTenant.uuid, product);
        showNotification(`Unmapped ${product} tenant successfully`, 'success');
        renderProductMappings();
      } catch (error) {
        console.error('Failed to unmap product tenant:', error);
        showNotification('Failed to unmap product tenant', 'error');
      }
    }

    // Close product mapping pane
    function closeProductMapping() {
      mappingPane.classList.add('hidden');
      currentProduct = null;
      allProductTenants = [];
      filteredProductTenants = [];
      productTenantSearch.value = '';
      productTenantGridBody.innerHTML = '';
    }

    // Product tenant search
    productTenantSearch.addEventListener('input', () => {
      renderProductTenantGrid();
    });

    // Edit mode
    editButton.addEventListener('click', () => {
      enterEditMode();
    });

    function enterEditMode() {
      if (currentProduct) {
        showNotification('Please close the product mapping pane first', 'warning');
        return;
      }

      isEditMode = true;
      readonlyView.classList.add('hidden');
      editView.classList.remove('hidden');
      editButton.classList.add('hidden');
      editModeActions.classList.remove('hidden');

      // Disable product mappings section
      const productMappingsSection = document.querySelector('.product-mappings');
      if (productMappingsSection) {
        productMappingsSection.classList.add('disabled');
      }

      markFormClean();

      // Track changes
      const formFields = editForm.querySelectorAll('vaadin-text-field, vaadin-select');
      formFields.forEach(field => {
        field.addEventListener('input', markFormDirty);
        field.addEventListener('change', markFormDirty);
      });
    }

    cancelEditButtonHeader.addEventListener('click', async () => {
      if (checkUnsavedChanges()) {
        const action = await confirmNavigationWithUnsavedChanges();
        if (action === 'save') {
          await handleSave();
          return;
        } else if (action === 'cancel') {
          return;
        }
      }
      exitEditMode();
    });

    function exitEditMode() {
      isEditMode = false;
      editView.classList.add('hidden');
      readonlyView.classList.remove('hidden');
      editButton.classList.remove('hidden');
      editModeActions.classList.add('hidden');

      // Re-enable product mappings section
      const productMappingsSection = document.querySelector('.product-mappings');
      if (productMappingsSection) {
        productMappingsSection.classList.remove('disabled');
      }

      markFormClean();
      renderTenantDetails();
    }

    saveButtonHeader.addEventListener('click', async () => {
      await handleSave();
    });

    async function handleSave() {
      const updates = {
        name: document.getElementById('editName').value,
        address1: document.getElementById('editAddress1').value,
        address2: document.getElementById('editAddress2').value,
        city: document.getElementById('editCity').value,
        state: document.getElementById('editState').value,
        postalCode: document.getElementById('editPostalCode').value,
        country: document.getElementById('editCountry').value
      };

      // Validate required fields
      if (!updates.name || !updates.address1 || !updates.city || !updates.state || !updates.country) {
        showNotification('Please fill in all required fields', 'error');
        return;
      }

      try {
        currentTenant = await updateKeystoneTenant(currentTenant.uuid, updates);
        showNotification('Tenant updated successfully', 'success');
        markFormClean();
        exitEditMode();
      } catch (error) {
        console.error('Failed to update tenant:', error);
        showNotification('Failed to update tenant', 'error');
      }
    }

    // Back button
    backButton.addEventListener('click', async () => {
      if (checkUnsavedChanges()) {
        const action = await confirmNavigationWithUnsavedChanges();
        if (action === 'save') {
          await handleSave();
          navigateToTenantGrid();
        } else if (action === 'discard') {
          markFormClean();
          navigateToTenantGrid();
        }
        // If 'cancel', do nothing
      } else {
        navigateToTenantGrid();
      }
    });

    // Show notification
    function showNotification(message, theme = 'primary') {
      notification.renderer = function(root) {
        root.textContent = message;
      };
      notification.setAttribute('theme', theme);
      notification.opened = true;
    }

    // Loading states
    function showLoading() {
      loadingState.classList.remove('hidden');
    }

    function hideLoading() {
      loadingState.classList.add('hidden');
    }

    // Utility: Escape HTML
    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // Setup people mapping dialog
    function setupPeopleMappingDialog() {
      peopleMappingDrawer.headerTitle = 'Select People to Map';

      peopleMappingDrawer.renderer = function(root) {
        if (!root.firstElementChild) {
          const container = document.createElement('div');
          container.style.padding = '24px';
          container.style.display = 'flex';
          container.style.flexDirection = 'column';
          container.style.height = '75vh';
          container.style.minWidth = '85vw';

          // Search and Actions Bar
          const actionsBar = document.createElement('div');
          actionsBar.style.display = 'flex';
          actionsBar.style.justifyContent = 'space-between';
          actionsBar.style.alignItems = 'center';
          actionsBar.style.marginBottom = '16px';
          actionsBar.style.gap = '16px';

          const searchContainer = document.createElement('div');
          searchContainer.style.flex = '1';
          searchContainer.style.maxWidth = '600px';
          const searchField = document.createElement('vaadin-text-field');
          searchField.id = 'peopleSearch';
          searchField.placeholder = 'Search by name or email...';
          searchField.setAttribute('theme', 'outlined');
          searchField.setAttribute('clear-button-visible', '');
          searchField.style.width = '100%';
          const searchIcon = document.createElement('i');
          searchIcon.className = 'fa-solid fa-magnifying-glass';
          searchIcon.slot = 'prefix';
          searchField.appendChild(searchIcon);
          searchContainer.appendChild(searchField);

          const actionsContainer = document.createElement('div');
          actionsContainer.style.display = 'flex';
          actionsContainer.style.gap = '8px';
          actionsContainer.style.alignItems = 'center';

          const countSpan = document.createElement('span');
          countSpan.id = 'selectedPeopleCount';
          countSpan.className = 'text-muted';
          countSpan.style.fontSize = '14px';
          countSpan.textContent = '0 selected';

          const clearBtn = document.createElement('vaadin-button');
          clearBtn.id = 'clearSelectionBtn';
          clearBtn.setAttribute('theme', 'tertiary small');
          clearBtn.textContent = 'Clear Selection';

          const mapBtn = document.createElement('vaadin-button');
          mapBtn.id = 'mapSelectedPeopleBtn';
          mapBtn.setAttribute('theme', 'primary small');
          mapBtn.disabled = true;
          mapBtn.innerHTML = '<i class="fa-solid fa-link" style="margin-right: 4px;"></i>Map Selected People';

          actionsContainer.appendChild(countSpan);
          actionsContainer.appendChild(clearBtn);
          actionsContainer.appendChild(mapBtn);

          actionsBar.appendChild(searchContainer);
          actionsBar.appendChild(actionsContainer);

          // People Grid
          const gridContainer = document.createElement('div');
          gridContainer.style.flex = '1';
          gridContainer.style.overflow = 'auto';
          gridContainer.style.border = '1px solid #e5e7eb';
          gridContainer.style.borderRadius = '4px';
          gridContainer.style.background = 'white';

          const table = document.createElement('table');
          table.className = 'people-grid';

          const thead = document.createElement('thead');
          thead.innerHTML = `
            <tr>
              <th style="width: 50px;"><vaadin-checkbox id="selectAllPeople"></vaadin-checkbox></th>
              <th>Name</th>
              <th>Email</th>
              <th>Product</th>
              <th>Product Tenant ID</th>
              <th style="width: 120px; text-align: center;">Grouped Users</th>
            </tr>
          `;

          const tbody = document.createElement('tbody');
          tbody.id = 'peopleGridBody';

          table.appendChild(thead);
          table.appendChild(tbody);
          gridContainer.appendChild(table);

          // Empty State
          const emptyState = document.createElement('div');
          emptyState.id = 'peopleEmpty';
          emptyState.className = 'empty-state hidden';
          emptyState.innerHTML = `
            <div class="empty-state-icon"><i class="fa-solid fa-users"></i></div>
            <div class="empty-state-title">No people found</div>
            <div class="empty-state-description">Try adjusting your search</div>
          `;
          gridContainer.appendChild(emptyState);

          // Pagination
          const pagination = document.createElement('div');
          pagination.style.display = 'flex';
          pagination.style.justifyContent = 'space-between';
          pagination.style.alignItems = 'center';
          pagination.style.marginTop = '16px';
          pagination.style.padding = '16px';
          pagination.style.background = '#f9fafb';
          pagination.style.borderRadius = '4px';

          const paginationInfo = document.createElement('div');
          paginationInfo.style.fontSize = '14px';
          paginationInfo.style.color = 'var(--lumo-secondary-text-color)';
          paginationInfo.innerHTML = `
            Showing <span id="peopleRangeStart">1</span>-<span id="peopleRangeEnd">50</span> of <span id="peopleTotalCount">0</span>
          `;

          const paginationButtons = document.createElement('div');
          paginationButtons.style.display = 'flex';
          paginationButtons.style.gap = '8px';

          const prevBtn = document.createElement('vaadin-button');
          prevBtn.id = 'peoplePrevPageBtn';
          prevBtn.setAttribute('theme', 'tertiary small');
          prevBtn.disabled = true;
          prevBtn.innerHTML = '<i class="fa-solid fa-chevron-left"></i> Previous';

          const nextBtn = document.createElement('vaadin-button');
          nextBtn.id = 'peopleNextPageBtn';
          nextBtn.setAttribute('theme', 'tertiary small');
          nextBtn.innerHTML = 'Next <i class="fa-solid fa-chevron-right"></i>';

          paginationButtons.appendChild(prevBtn);
          paginationButtons.appendChild(nextBtn);

          pagination.appendChild(paginationInfo);
          pagination.appendChild(paginationButtons);

          // Assemble container
          container.appendChild(actionsBar);
          container.appendChild(gridContainer);
          container.appendChild(pagination);

          root.appendChild(container);

          // Store references to elements
          peopleSearch = searchField;
          peopleGridBody = tbody;
          selectAllPeople = thead.querySelector('#selectAllPeople');
          selectedPeopleCount = countSpan;
          clearSelectionBtn = clearBtn;
          mapSelectedPeopleBtn = mapBtn;
          peoplePrevPageBtn = prevBtn;
          peopleNextPageBtn = nextBtn;
          peopleRangeStart = paginationInfo.querySelector('#peopleRangeStart');
          peopleRangeEnd = paginationInfo.querySelector('#peopleRangeEnd');
          peopleTotalCount = paginationInfo.querySelector('#peopleTotalCount');
          peopleEmpty = emptyState;

          // Attach event listeners
          setupPeopleGridEventListeners();
        }
      };

      peopleMappingDrawer.footerRenderer = function(root) {
        if (!root.firstElementChild) {
          const closeBtn = document.createElement('vaadin-button');
          closeBtn.textContent = 'Close';
          closeBtn.addEventListener('click', () => {
            peopleMappingDrawer.opened = false;
            clearPeopleSelection();
          });
          root.appendChild(closeBtn);
        }
      };
    }

    // Setup event listeners for people grid
    function setupPeopleGridEventListeners() {
      // People search
      peopleSearch.addEventListener('input', () => {
        filterAndRenderPeople();
      });

      // Select all people
      selectAllPeople.addEventListener('change', (e) => {
        const startIndex = (currentPeoplePage - 1) * peoplePerPage;
        const endIndex = startIndex + peoplePerPage;
        const pagePeople = filteredPeople.slice(startIndex, endIndex);

        if (e.target.checked) {
          pagePeople.forEach(person => selectedPeopleIds.add(person.id));
        } else {
          pagePeople.forEach(person => selectedPeopleIds.delete(person.id));
        }

        renderPeopleGrid();
        updateSelectionUI();
      });

      // Clear selection
      clearSelectionBtn.addEventListener('click', () => {
        clearPeopleSelection();
      });

      // Map selected people
      mapSelectedPeopleBtn.addEventListener('click', () => {
        showPeopleMappingDialog();
      });

      // Pagination handlers
      peoplePrevPageBtn.addEventListener('click', () => {
        if (currentPeoplePage > 1) {
          currentPeoplePage--;
          renderPeopleGrid();
          updatePeoplePagination();
        }
      });

      peopleNextPageBtn.addEventListener('click', () => {
        const totalPages = Math.ceil(filteredPeople.length / peoplePerPage);
        if (currentPeoplePage < totalPages) {
          currentPeoplePage++;
          renderPeopleGrid();
          updatePeoplePagination();
        }
      });
    }

    // Open people mapping dialog
    openPeopleMappingBtn.addEventListener('click', async () => {
      if (isEditMode) {
        showNotification('Please save or cancel your changes first', 'warning');
        return;
      }

      console.log('Opening people mapping dialog...');
      setupPeopleMappingDialog();
      peopleMappingDrawer.opened = true;
      await loadPeopleGrid();
    });

    // Load people grid
    async function loadPeopleGrid() {
      try {
        console.log('Loading people grid...');
        allPeople = await getAllPeople();
        console.log('Loaded people:', allPeople.length);
        filterAndRenderPeople();
      } catch (error) {
        console.error('Failed to load people:', error);
        showNotification('Failed to load people', 'error');
      }
    }

    // Filter and render people
    function filterAndRenderPeople() {
      const searchTerm = peopleSearch.value.toLowerCase();

      filteredPeople = allPeople.filter(person => {
        const fullName = `${person.firstName} ${person.lastName}`.toLowerCase();
        const email = person.email.toLowerCase();
        return fullName.includes(searchTerm) || email.includes(searchTerm);
      });

      currentPeoplePage = 1;
      renderPeopleGrid();
      updatePeoplePagination();
    }

    // Render people grid
    function renderPeopleGrid() {
      const startIndex = (currentPeoplePage - 1) * peoplePerPage;
      const endIndex = startIndex + peoplePerPage;
      const pagePeople = filteredPeople.slice(startIndex, endIndex);

      if (pagePeople.length === 0) {
        peopleGridBody.innerHTML = '';
        peopleEmpty.classList.remove('hidden');
        return;
      }

      peopleEmpty.classList.add('hidden');
      peopleGridBody.innerHTML = '';

      pagePeople.forEach(person => {
        const row = document.createElement('tr');
        const isSelected = selectedPeopleIds.has(person.id);

        // Display grouped user count
        const groupedCount = person.groupedUserCount || '';

        row.innerHTML = `
          <td>
            <vaadin-checkbox ${isSelected ? 'checked' : ''} data-person-id="${escapeHtml(person.id)}"></vaadin-checkbox>
          </td>
          <td>${escapeHtml(person.firstName)} ${escapeHtml(person.lastName)}${person.isJoinedAccount ? ' <vwc-badge text="Joined" appearance="info"></vwc-badge>' : ''}</td>
          <td>${escapeHtml(person.email)}</td>
          <td>${escapeHtml(person.product)}</td>
          <td style="font-family: 'Courier New', monospace; font-size: 12px;">${escapeHtml(person.productTenantId)}</td>
          <td style="text-align: center; color: var(--lumo-secondary-text-color);">${groupedCount}</td>
        `;

        // Handle row click to view joined accounts
        if (person.isJoinedAccount) {
          row.style.cursor = 'pointer';
          row.addEventListener('click', (e) => {
            if (e.target.tagName !== 'VAADIN-CHECKBOX') {
              viewJoinedAccounts(person.mappingId);
            }
          });
        }

        // Handle checkbox change
        const checkbox = row.querySelector('vaadin-checkbox');
        checkbox.addEventListener('click', (e) => {
          e.stopPropagation(); // Prevent row click from firing
        });
        checkbox.addEventListener('change', (e) => {
          if (e.target.checked) {
            selectedPeopleIds.add(person.id);
          } else {
            selectedPeopleIds.delete(person.id);
          }
          updateSelectionUI();
        });

        peopleGridBody.appendChild(row);
      });

      updateSelectionUI();
    }

    // Update people pagination
    function updatePeoplePagination() {
      const totalPeople = filteredPeople.length;
      const startIndex = (currentPeoplePage - 1) * peoplePerPage + 1;
      const endIndex = Math.min(currentPeoplePage * peoplePerPage, totalPeople);

      peopleRangeStart.textContent = totalPeople > 0 ? startIndex : 0;
      peopleRangeEnd.textContent = endIndex;
      peopleTotalCount.textContent = totalPeople;

      peoplePrevPageBtn.disabled = currentPeoplePage === 1;
      peopleNextPageBtn.disabled = endIndex >= totalPeople;
    }

    // Clear people selection
    function clearPeopleSelection() {
      selectedPeopleIds.clear();
      renderPeopleGrid();
      updateSelectionUI();
    }

    // Update selection UI
    function updateSelectionUI() {
      const count = selectedPeopleIds.size;
      selectedPeopleCount.textContent = `${count} selected`;
      mapSelectedPeopleBtn.disabled = count < 2;

      // Update select all checkbox
      const startIndex = (currentPeoplePage - 1) * peoplePerPage;
      const endIndex = startIndex + peoplePerPage;
      const pagePeople = filteredPeople.slice(startIndex, endIndex);
      const pageSelected = pagePeople.every(person => selectedPeopleIds.has(person.id));
      selectAllPeople.checked = pageSelected && pagePeople.length > 0;
    }

    // Show people mapping confirmation dialog
    function showPeopleMappingDialog() {
      const selectedPeople = allPeople.filter(p => selectedPeopleIds.has(p.id));

      peopleMappingDialog.renderer = function(root) {
        if (!root.firstElementChild) {
          const content = document.createElement('div');
          content.style.padding = '0 24px 16px';
          content.style.minWidth = '500px';

          const description = document.createElement('p');
          description.textContent = 'Select the primary user account. This account will be displayed in user lists, and all selected accounts will be joined together.';
          description.style.marginBottom = '16px';
          content.appendChild(description);

          const peopleList = document.createElement('div');
          peopleList.style.display = 'flex';
          peopleList.style.flexDirection = 'column';
          peopleList.style.gap = '8px';

          selectedPeople.forEach((person, index) => {
            const personItem = document.createElement('div');
            personItem.style.display = 'flex';
            personItem.style.alignItems = 'center';
            personItem.style.padding = '12px';
            personItem.style.border = '1px solid #e5e7eb';
            personItem.style.borderRadius = '4px';
            personItem.style.gap = '12px';

            const radio = document.createElement('input');
            radio.type = 'radio';
            radio.name = 'primaryPerson';
            radio.value = person.id;
            radio.style.width = '20px';
            radio.style.height = '20px';
            radio.style.cursor = 'pointer';
            if (index === 0) radio.checked = true;

            const info = document.createElement('div');
            info.style.flex = '1';
            info.innerHTML = `
              <div style="font-weight: 600;">${escapeHtml(person.firstName)} ${escapeHtml(person.lastName)}</div>
              <div style="font-size: 12px; color: var(--lumo-secondary-text-color);">${escapeHtml(person.email)}</div>
              <div style="font-size: 12px; color: var(--lumo-secondary-text-color);">${escapeHtml(person.product)} - ${escapeHtml(person.productTenantId)}</div>
            `;

            personItem.appendChild(radio);
            personItem.appendChild(info);
            peopleList.appendChild(personItem);
          });

          content.appendChild(peopleList);
          root.appendChild(content);
        }
      };

      peopleMappingDialog.footerRenderer = function(root) {
        if (!root.firstElementChild) {
          const buttonContainer = document.createElement('div');
          buttonContainer.style.display = 'flex';
          buttonContainer.style.gap = '8px';
          buttonContainer.style.justifyContent = 'flex-end';

          const cancelButton = document.createElement('vaadin-button');
          cancelButton.textContent = 'Cancel';
          cancelButton.addEventListener('click', () => {
            peopleMappingDialog.opened = false;
          });

          const saveButton = document.createElement('vaadin-button');
          saveButton.textContent = 'Create Mapping';
          saveButton.setAttribute('theme', 'primary');
          saveButton.addEventListener('click', async () => {
            await handleCreatePeopleMapping();
          });

          buttonContainer.appendChild(cancelButton);
          buttonContainer.appendChild(saveButton);
          root.appendChild(buttonContainer);
        }
      };

      peopleMappingDialog.opened = true;
    }

    // Handle create people mapping
    async function handleCreatePeopleMapping() {
      const selectedRadio = peopleMappingDialog.querySelector('input[name="primaryPerson"]:checked');
      const primaryPersonId = selectedRadio?.value;

      if (!primaryPersonId) {
        showNotification('Please select a primary user', 'warning');
        return;
      }

      try {
        const personIds = Array.from(selectedPeopleIds);
        await createPeopleMapping(personIds, primaryPersonId);

        showNotification('People mapping created successfully', 'success');
        peopleMappingDialog.opened = false;
        clearPeopleSelection();
        await loadPeopleGrid();
      } catch (error) {
        console.error('Failed to create people mapping:', error);
        showNotification(error.message || 'Failed to create people mapping', 'error');
      }
    }

    // View joined accounts
    async function viewJoinedAccounts(mappingId) {
      try {
        const { mapping, people } = await getPeopleMappingDetails(mappingId);
        showJoinedAccountsDialog(mapping, people);
      } catch (error) {
        console.error('Failed to load mapping details:', error);
        showNotification('Failed to load mapping details', 'error');
      }
    }

    // Show joined accounts dialog
    function showJoinedAccountsDialog(mapping, people) {
      const dialog = document.createElement('vaadin-dialog');
      dialog.headerTitle = 'Joined User Accounts';

      dialog.renderer = function(root) {
        if (!root.firstElementChild) {
          const content = document.createElement('div');
          content.style.padding = '0 24px 16px';
          content.style.minWidth = '500px';

          const description = document.createElement('p');
          description.textContent = 'These user accounts are mapped together as one person. You can unmap individual accounts to return them to the main user list.';
          description.style.marginBottom = '16px';
          content.appendChild(description);

          const peopleList = document.createElement('div');
          peopleList.style.display = 'flex';
          peopleList.style.flexDirection = 'column';
          peopleList.style.gap = '8px';

          people.forEach(person => {
            const personItem = document.createElement('div');
            personItem.style.display = 'flex';
            personItem.style.alignItems = 'center';
            personItem.style.justifyContent = 'space-between';
            personItem.style.padding = '12px';
            personItem.style.border = '1px solid #e5e7eb';
            personItem.style.borderRadius = '4px';

            const info = document.createElement('div');
            info.innerHTML = `
              <div style="font-weight: 600;">
                ${escapeHtml(person.firstName)} ${escapeHtml(person.lastName)}
                ${person.id === mapping.primaryPersonId ? '<vwc-badge text="Primary" appearance="success"></vwc-badge>' : ''}
              </div>
              <div style="font-size: 12px; color: var(--lumo-secondary-text-color);">${escapeHtml(person.email)}</div>
              <div style="font-size: 12px; color: var(--lumo-secondary-text-color);">${escapeHtml(person.product)} - ${escapeHtml(person.productTenantId)}</div>
            `;

            const unmapBtn = document.createElement('vaadin-button');
            unmapBtn.textContent = 'Unmap';
            unmapBtn.setAttribute('theme', 'error small');
            unmapBtn.addEventListener('click', async () => {
              await handleUnmapPerson(person.id, dialog);
            });

            personItem.appendChild(info);
            personItem.appendChild(unmapBtn);
            peopleList.appendChild(personItem);
          });

          content.appendChild(peopleList);
          root.appendChild(content);
        }
      };

      dialog.footerRenderer = function(root) {
        if (!root.firstElementChild) {
          const closeButton = document.createElement('vaadin-button');
          closeButton.textContent = 'Close';
          closeButton.addEventListener('click', () => {
            dialog.opened = false;
            dialog.remove();
          });

          root.appendChild(closeButton);
        }
      };

      document.body.appendChild(dialog);
      dialog.opened = true;
    }

    // Handle unmap person
    async function handleUnmapPerson(personId, dialog) {
      try {
        await unmapPerson(personId);
        showNotification('User unmapped successfully', 'success');
        dialog.opened = false;
        dialog.remove();
        await loadPeopleGrid();
      } catch (error) {
        console.error('Failed to unmap person:', error);
        showNotification(error.message || 'Failed to unmap person', 'error');
      }
    }

    // Custom accordion functionality
    const accordionHeader = document.getElementById('accordionHeader');
    const accordionContent = document.getElementById('accordionContent');
    const accordionChevron = document.getElementById('accordionChevron');
    const accordionHeaderActions = document.getElementById('accordionHeaderActions');
    let isAccordionOpen = false;

    // Toggle accordion
    const toggleAccordion = () => {
      isAccordionOpen = !isAccordionOpen;

      if (isAccordionOpen) {
        accordionContent.style.display = 'block';
        accordionChevron.style.transform = 'rotate(90deg)';
        accordionHeaderActions.style.display = 'flex';
      } else {
        accordionContent.style.display = 'none';
        accordionChevron.style.transform = 'rotate(0deg)';
        accordionHeaderActions.style.display = 'none';
      }
    };

    // Click handler for accordion header
    if (accordionHeader) {
      accordionHeader.addEventListener('click', (e) => {
        // Don't toggle if clicking on buttons
        if (e.target.closest('vaadin-button')) {
          return;
        }
        toggleAccordion();
      });
    }

    // Initialize
    loadTenantDetails();
  </script>
</body>
</html>
