{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aithera",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "exec python3 -m http.server ${PORT:-8765}"],
      "port": 8765,
      "autoPort": true
    },
    {
      "name": "editor",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "export PATH=/opt/homebrew/bin:$PATH && cd editor && exec npm run dev -- --port 5174"],
      "port": 5174
    }
  ]
}
