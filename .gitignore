.DS_Store

# Playwright MCP session artifacts (console logs, page snapshots, screenshots)
.playwright-mcp/

# Wrangler local cache / state (feedback widget worker)
.wrangler/

# Per-prototype local preview config (personal absolute paths — keep out of the shared repo)
products/aithera/lesson-presentation/.claude/

# Unlock sentinel for editing the Pages landing page (see scripts/git-hooks/README.md)
.claude/.allow-landing-edit

# Review screenshots dropped at a product's root while iterating. Scoped to the
# product ROOT on purpose — assets in subfolders (e.g. aithera/assets/courses)
# are real, tracked content and must keep being tracked.
products/aithera/*.png
products/Keystone Department Hub/*.png

# Local scratch copies that were never meant for the shared repo: a vendored
# design-system bundle (8.9MB) and a pre-versioning backup of the hub.
products/Keystone Department Hub/project/
products/Keystone Hub- old/
